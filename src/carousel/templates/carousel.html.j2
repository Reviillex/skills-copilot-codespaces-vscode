<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ brand.font | replace(' ', '+') }}:wght@400;600;800&display=block" rel="stylesheet">
<style>
  :root {
    --primary: {{ brand.primary }};
    --accent: {{ brand.accent }};
    --bg: {{ brand.background }};
    --text: {{ brand.text }};
    --caveat-bg: {{ brand.caveat_background }};
    --font: "{{ brand.font }}", "Inter", "Helvetica Neue", Arial, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #777; font-family: var(--font); }
  .slide {
    width: 1080px; height: 1350px; padding: 88px 88px 72px;
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--bg); color: var(--text); position: relative;
  }
  .slide + .slide { margin-top: 20px; }
  .top, .bottom { display: flex; justify-content: space-between; align-items: center; flex: none; }
  .top { font-size: 28px; font-weight: 600; }
  .tag { color: var(--primary); letter-spacing: 0.02em; }
  .count { opacity: 0.55; font-variant-numeric: tabular-nums; }
  .bottom { font-size: 24px; opacity: 0.7; gap: 32px; padding-top: 32px; border-top: 2px solid currentColor; border-color: rgba(0,0,0,0.12); }
  .cite { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .handle { font-weight: 600; flex: none; }
  .content { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 40px; min-height: 0; overflow: hidden; }
  .label { font-size: 30px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--primary); display: flex; align-items: center; gap: 16px; }
  h1 { font-size: 64px; line-height: 1.15; font-weight: 800; letter-spacing: -0.01em; }
  .body { font-size: 40px; line-height: 1.42; }
  .body p + p { margin-top: 18px; }
  .body ul { list-style: none; display: flex; flex-direction: column; gap: 22px; }
  .body li { padding-left: 52px; position: relative; }
  .body li::before { content: ""; position: absolute; left: 0; top: 0.42em; width: 26px; height: 26px; border-radius: 50%; background: var(--accent); }
  .hl { color: var(--accent); font-weight: 800; }

  /* cover */
  .role-hook { background: var(--primary); color: #fff; }
  .role-hook .tag { color: #fff; opacity: 0.85; }
  .role-hook h1 { font-size: 92px; line-height: 1.08; }
  .role-hook .bottom { border-color: rgba(255,255,255,0.25); }
  .badge { align-self: flex-start; font-size: 30px; font-weight: 600; padding: 16px 28px; border-radius: 999px; background: rgba(255,255,255,0.14); }
  .swipe { font-size: 30px; font-weight: 600; opacity: 0.85; align-self: flex-end; }

  /* big number */
  .big { font-size: 220px; line-height: 1; font-weight: 800; color: var(--accent); letter-spacing: -0.03em; }

  /* caveat */
  .role-caveat { background: var(--caveat-bg); }
  .role-caveat .label { color: var(--accent); }
  .bang { width: 48px; height: 48px; border-radius: 50%; background: var(--accent); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; }

  /* reference slide */
  .role-reference { background: var(--primary); color: #fff; }
  .role-reference .tag, .role-reference .label { color: #fff; }
  .role-reference .bottom { border-color: rgba(255,255,255,0.25); }
  .ref { font-size: 34px; line-height: 1.45; }
  .disclaimer { font-size: 30px; line-height: 1.45; padding: 28px 32px; border-radius: 20px; background: rgba(255,255,255,0.12); }
  .author { font-size: 36px; font-weight: 800; }
  .sample { position: absolute; top: 24px; left: 50%; transform: translateX(-50%); background: #C1121F; color: #fff; font-size: 24px; font-weight: 800; padding: 6px 18px; border-radius: 8px; letter-spacing: 0.06em; }
</style>
</head>
<body>
{% for s in slides %}
<section class="slide role-{{ s.role }}">
  {% if sample %}<div class="sample">CONTOH FIKTIF</div>{% endif %}
  <header class="top"><span class="tag">{{ carousel.topic_tag }}</span><span class="count">{{ loop.index }}/{{ total }}</span></header>
  <main class="content">
  {% if s.role == "hook" %}
    <span class="badge">{{ carousel.evidence_label }}</span>
    <h1 class="fit">{{ s.headline | rich }}</h1>
    {% if s.body %}<div class="body fit">{{ s.body | rich }}</div>{% endif %}
    <span class="swipe">Geser untuk selengkapnya &rarr;</span>
  {% elif s.role == "number" %}
    <div class="big fit">{{ s.big_number }}</div>
    <h1 class="fit">{{ s.headline | rich }}</h1>
    {% if s.body %}<div class="body fit">{{ s.body | rich }}</div>{% endif %}
  {% elif s.role == "caveat" %}
    <span class="label"><span class="bang">!</span>Catatan penting</span>
    <h1 class="fit">{{ s.headline | rich }}</h1>
    {% if s.body %}<div class="body fit">{{ s.body | rich }}</div>{% endif %}
  {% elif s.role == "takeaway" %}
    <span class="label">Apa artinya untuk {{ sapaan }}?</span>
    <h1 class="fit">{{ s.headline | rich }}</h1>
    {% if s.body %}<div class="body fit">{{ s.body | rich }}</div>{% endif %}
  {% elif s.role == "reference" %}
    <span class="label">Sumber</span>
    <p class="ref fit">{{ paper.full_citation }}</p>
    <p class="disclaimer fit">Konten ini untuk edukasi, bukan pengganti konsultasi dengan dokter. Hasil satu penelitian belum tentu berlaku untuk setiap orang.</p>
    <p class="author">{{ brand.author }}<br><span style="font-weight:600;opacity:.85">{{ brand.handle }}</span></p>
  {% else %}
    <h1 class="fit">{{ s.headline | rich }}</h1>
    {% if s.body %}<div class="body fit">{{ s.body | rich }}</div>{% endif %}
  {% endif %}
  </main>
  <footer class="bottom"><span class="cite">{{ paper.short_citation }}</span><span class="handle">{{ brand.handle }}</span></footer>
</section>
{% endfor %}
</body>
</html>
